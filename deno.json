    "@nivo/line": "npm:@nivo/line@^0.87.0",
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^5.11.9",
    "@testing-library/react": "npm:@testing-library/react@^11.2.3",
    "@testing-library/user-event": "npm:@testing-library/user-event@^12.6.2",
    "@types/loadable__component": "npm:@types/loadable__component@^5.13.4",
    "@types/react": "npm:@types/react@^18.3.11",
    "@types/react-dom": "npm:@types/react-dom@^18.3.1",
    "@vitejs/plugin-react-swc": "npm:@vitejs/plugin-react-swc@^3.7.1",
    "arptable-js": "npm:arptable-js@0.0.2",
    "autoprefixer": "npm:autoprefixer@^10.4.19",
    "bootstrap": "npm:bootstrap@^5.3.3",
    "get-ip-range": "npm:get-ip-range@^4.0.1",
    "human-time": "npm:human-time@^0.0.2",
    "moment": "npm:moment@^2.30.1",
    "postcss": "npm:postcss@^8.4.38",
    "postcss-load-config": "npm:postcss-load-config@^6.0.1",
    "postcss-nesting": "npm:postcss-nesting@^13.0.1",
    "pretty-bytes": "npm:pretty-bytes@^5.5.0",
    "react": "npm:react@^18.3.1",
    "react-bootstrap": "npm:react-bootstrap@^2.10.5",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-query": "npm:react-query@^3.6.0",
    "sass": "npm:sass@^1.62.0",
    "tailwindcss": "npm:tailwindcss@^3.4.3",
